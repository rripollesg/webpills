---
import type { UI } from '../i18n';

interface Props {
	t: UI;
}

const { t } = Astro.props;

const icons: Record<string, string> = {
	calendar:
		'<rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M8 3v4M16 3v4M3.5 10h17"/>',
	scan: '<path d="M7 4H5a1 1 0 0 0-1 1v2M17 4h2a1 1 0 0 1 1 1v2M7 20H5a1 1 0 0 1-1-1v-2M17 20h2a1 1 0 0 0 1-1v-2"/><rect x="8" y="8" width="8" height="8" rx="1.5"/>',
	clipboard:
		'<rect x="7" y="4.5" width="10" height="15" rx="2"/><path d="M9 4.5h6v2H9zM9.5 11h5M9.5 14.5h5"/>',
	heart:
		'<path d="M12 20s-7-4.3-7-9.2A3.8 3.8 0 0 1 12 8a3.8 3.8 0 0 1 7 2.8C19 15.7 12 20 12 20Z"/>',
	droplet: '<path d="M12 3s6 7 6 11a6 6 0 1 1-12 0c0-4 6-11 6-11Z"/>',
	body: '<circle cx="12" cy="5" r="2.2"/><path d="M8 10.5h8l-1.2 9H9.2L8 10.5Zm4 0v5"/>',
	mic: '<rect x="9.2" y="3.5" width="5.6" height="10" rx="2.8"/><path d="M6.5 11.5a5.5 5.5 0 0 0 11 0M12 17v3.5M9.5 20.5h5"/>',
	users:
		'<circle cx="9" cy="8" r="3"/><path d="M3.8 19c0-2.8 2.3-5 5.2-5s5.2 2.2 5.2 5"/><circle cx="17" cy="9" r="2.4"/><path d="M15.5 14.2c2.4.3 4.3 2.2 4.3 4.8"/>',
	tv: '<rect x="3.5" y="5.5" width="17" height="11.5" rx="2"/><path d="M9 20h6M12 17v3"/>',
};

const iconTones: Record<
	string,
	'teal' | 'purple' | 'blue' | 'coral' | 'pink' | 'amber' | 'green' | 'indigo' | 'sky'
> = {
	calendar: 'teal',
	scan: 'purple',
	clipboard: 'blue',
	heart: 'coral',
	droplet: 'pink',
	body: 'amber',
	mic: 'green',
	users: 'indigo',
	tv: 'sky',
};
---

<section id="funciones" class="features light-section">
	<div class="container">
		<div class="section-head reveal">
			<span class="eyebrow light">{t.features.eyebrow}</span>
			<h2>{t.features.title}</h2>
			<p>{t.features.description}</p>
		</div>

		<div class="grid">
			{
				t.features.items.map((item) => (
					<article class="card reveal">
						<span class:list={['icon', `tone-${iconTones[item.icon]}`]} aria-hidden="true">
							<svg
								width="22"
								height="22"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.8"
								stroke-linecap="round"
								stroke-linejoin="round"
								set:html={icons[item.icon]}
							/>
						</span>
						<h3>{item.title}</h3>
						<p>{item.description}</p>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.light-section {
		background: var(--light);
		color: var(--light-ink);
		padding-top: 72px;
	}

	.light-section h2,
	.light-section h3 {
		color: var(--light-ink);
	}

	.eyebrow.light {
		background: rgba(26, 168, 155, 0.1);
		border-color: rgba(26, 168, 155, 0.25);
		color: #0f766e;
	}

	.section-head p {
		color: #5b6f78;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 18px;
	}

	.card {
		background: #fff;
		border: 1px solid rgba(26, 46, 56, 0.08);
		border-radius: var(--radius-md);
		padding: 26px 24px;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.card:hover {
		transform: translateY(-4px);
		box-shadow: 0 18px 40px rgba(15, 40, 50, 0.08);
	}

	.icon {
		width: 48px;
		height: 48px;
		border-radius: 50%;
		display: grid;
		place-items: center;
		margin-bottom: 16px;
	}

	.icon.tone-teal {
		background: #e6f7f4;
		color: #0f766e;
	}

	.icon.tone-green {
		background: #e8f5ef;
		color: #1a7f5a;
	}

	.icon.tone-purple {
		background: #f0ebff;
		color: #7c3aed;
	}

	.icon.tone-blue {
		background: #e8f0fe;
		color: #2563eb;
	}

	.icon.tone-coral {
		background: #fdeee8;
		color: #d4534a;
	}

	.icon.tone-pink {
		background: #fce7f3;
		color: #db2777;
	}

	.icon.tone-amber {
		background: #fef3c7;
		color: #d97706;
	}

	.icon.tone-indigo {
		background: #e0e7ff;
		color: #4f46e5;
	}

	.icon.tone-sky {
		background: #e0f2fe;
		color: #0284c7;
	}

	.card h3 {
		font-size: 17px;
		margin-bottom: 8px;
	}

	.card p {
		font-size: 14.5px;
		color: #5b6f78;
		line-height: 1.55;
	}

	@media (max-width: 960px) {
		.grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 640px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
