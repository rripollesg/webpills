---
import type { UI } from '../i18n';

interface Props {
	t: UI;
}

const { t } = Astro.props;
---

<section id="preguntas" class="faq">
	<div class="container">
		<div class="faq-grid">
			<div class="faq-intro reveal">
				<span class="eyebrow">{t.faq.eyebrow}</span>
				<h2>{t.faq.title}</h2>
			</div>

			<div class="accordion reveal">
				{
					t.faq.items.map((item, index) => (
						<details class="faq-item" open={index === 0}>
							<summary>
								<span>{item.question}</span>
								<svg class="chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
									<path
										d="m6 9 6 6 6-6"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
									/>
								</svg>
							</summary>
							<p>{item.answer}</p>
						</details>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	.faq {
		padding: 72px 0;
	}

	.faq-grid {
		display: grid;
		grid-template-columns: 0.7fr 1.3fr;
		gap: 48px;
		align-items: start;
	}

	.faq-intro h2 {
		font-size: clamp(28px, 3.5vw, 40px);
		margin-top: 16px;
	}

	.accordion {
		border-top: 1px solid var(--border);
	}

	.faq-item {
		border-bottom: 1px solid var(--border);
	}

	.faq-item summary {
		list-style: none;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 22px 0;
		cursor: pointer;
		font-weight: 700;
		font-size: 15px;
	}

	.faq-item summary::-webkit-details-marker {
		display: none;
	}

	.chevron {
		flex-shrink: 0;
		color: var(--ink-muted);
		transition: transform 0.2s ease, color 0.2s ease;
	}

	.faq-item[open] .chevron {
		transform: rotate(180deg);
		color: var(--mint);
	}

	.faq-item p {
		padding: 0 0 22px;
		max-width: 620px;
		font-size: 14.5px;
		color: var(--ink-muted);
		line-height: 1.65;
	}

	@media (max-width: 800px) {
		.faq-grid {
			grid-template-columns: 1fr;
			gap: 24px;
		}
	}
</style>
