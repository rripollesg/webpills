---
import type { UI } from '../i18n';
import { apkDownloads, isExternalUrl, isStorePending, storeHref, storeUrls } from '../config/downloads';

interface Props {
	t: UI;
	class?: string;
}

const { t, class: className } = Astro.props;

const appStoreHref = storeHref(storeUrls.appStore);
const googlePlayHref = storeHref(storeUrls.googlePlay);
const appStorePending = isStorePending(storeUrls.appStore);
const googlePlayPending = isStorePending(storeUrls.googlePlay);
---

<div class:list={['store-block', className]}>
	<div class="store-row">
		<a
			href={appStoreHref}
			class:list={['store-badge', appStorePending && 'download-trigger-store']}
			aria-label={`${t.cta.availableOn} ${t.cta.appStore}`}
			{...(appStorePending ? {} : { target: '_blank', rel: 'noopener noreferrer' })}
		>
			<span class="store-icon-wrap" aria-hidden="true">
				<svg class="store-icon apple" width="24" height="24" viewBox="0 0 24 24">
					<path
						fill="currentColor"
						d="M17.05 20.28c-.98.95-2.05.88-3.08.4-1.09-.5-2.08-.48-3.24 0-1.44.62-2.2.44-3.06-.4C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"
					></path>
				</svg>
			</span>
			<span class="store-copy">
				<small>{t.cta.availableOn}</small>
				<strong>{t.cta.appStore}</strong>
			</span>
		</a>

		<a
			href={googlePlayHref}
			class:list={['store-badge', googlePlayPending && 'download-trigger-store']}
			aria-label={`${t.cta.availableOn} ${t.cta.googlePlay}`}
			{...(googlePlayPending ? {} : { target: '_blank', rel: 'noopener noreferrer' })}
		>
			<span class="store-icon-wrap play" aria-hidden="true">
				<svg class="store-icon play" width="24" height="24" viewBox="0 0 512 512">
					<path
						fill="#2196F3"
						d="M325.3 234.3 104.6 14.6C98.3 10.2 89.8 14.2 89.8 22.3v467.4c0 8.1 8.5 12.1 14.8 7.7L325.3 277.7c4.1-2.8 4.1-8.9 0-11.6z"></path>
					<path fill="#FFC107" d="M416.8 256l-91.5-21.7L325.3 234.3l91.5 21.7z"></path>
					<path fill="#4CAF50" d="M325.3 234.3 104.6 14.6l220.7 219.7L325.3 234.3z"></path>
					<path fill="#F44336" d="M325.3 277.7 104.6 497.4l220.7-219.7L325.3 277.7z"></path>
				</svg>
			</span>
			<span class="store-copy">
				<small>{t.cta.availableOn}</small>
				<strong>{t.cta.googlePlay}</strong>
			</span>
		</a>
	</div>

	<div class="store-row apk-row">
		<a
			href={apkDownloads.pills}
			class="store-badge store-badge-apk"
			{...(isExternalUrl(apkDownloads.pills)
				? { target: '_blank', rel: 'noopener noreferrer' }
				: { download: true })}
			aria-label={`${t.cta.apkDirect} Pills`}
		>
			<span class="store-icon-wrap apk" aria-hidden="true">
				<svg class="store-icon apk" width="24" height="24" viewBox="0 0 24 24" fill="none">
					<path
						d="M12 4v10m-4-4 4 4 4-4M5 19h14"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</span>
			<span class="store-copy">
				<small>{t.cta.apkDirect}</small>
				<strong>Pills</strong>
			</span>
		</a>

		<a
			href={apkDownloads.pillsTv}
			class="store-badge store-badge-tv"
			{...(isExternalUrl(apkDownloads.pillsTv)
				? { target: '_blank', rel: 'noopener noreferrer' }
				: { download: true })}
			aria-label={`${t.cta.apkDirect} ${t.cta.pillsTv}`}
		>
			<span class="store-icon-wrap tv" aria-hidden="true">
				<svg class="store-icon tv" width="24" height="24" viewBox="0 0 24 24" fill="none">
					<rect x="3.5" y="5.5" width="17" height="11.5" rx="2" stroke="currentColor" stroke-width="1.8"
					></rect>
					<path d="M9 20h6M12 17v3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
				</svg>
			</span>
			<span class="store-copy">
				<small>{t.cta.pillsTvHint}</small>
				<strong>{t.cta.pillsTv}</strong>
			</span>
		</a>
	</div>

	<div class="trust-row" aria-label={t.cta.trustLine}>
		<div class="stars" aria-hidden="true">
			{
				Array.from({ length: 5 }).map(() => (
					<svg width="18" height="18" viewBox="0 0 24 24">
						<path
							fill="currentColor"
							d="M12 2l2.9 6.9 7.1.6-5.4 4.7 1.7 7-6.3-3.8-6.3 3.8 1.7-7L2 9.5l7.1-.6L12 2z"
						/>
					</svg>
				))
			}
		</div>
		<p class="trust-text">{t.cta.trustLine}</p>
	</div>
</div>

<style>
	.store-block {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 14px;
	}

	.store-row {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 12px;
	}

	.apk-row {
		padding-top: 2px;
	}

	.store-badge {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		min-width: 190px;
		padding: 10px 18px 10px 14px;
		border-radius: var(--radius-pill);
		background: #0f172a;
		color: #fff;
		border: 1px solid rgba(255, 255, 255, 0.08);
		transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
	}

	.store-badge:hover {
		transform: translateY(-2px);
		background: #1a2740;
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.28);
	}

	.store-badge-apk {
		border-color: rgba(125, 255, 240, 0.28);
	}

	.store-badge-apk:hover {
		background: #0f2a32;
		box-shadow: 0 12px 28px rgba(125, 255, 240, 0.16);
	}

	.store-badge-tv {
		border-color: rgba(139, 92, 246, 0.35);
	}

	.store-badge-tv:hover {
		background: #1f1638;
		box-shadow: 0 12px 28px rgba(124, 58, 237, 0.22);
	}

	.store-icon-wrap {
		width: 28px;
		height: 28px;
		display: grid;
		place-items: center;
		flex-shrink: 0;
	}

	.store-icon {
		display: block;
	}

	.store-icon.apple {
		color: #fff;
	}

	.store-icon.play {
		width: 24px;
		height: 24px;
	}

	.store-icon-wrap.apk {
		color: var(--mint);
	}

	.store-icon-wrap.tv {
		color: #c4b5fd;
	}

	.store-icon.tv,
	.store-icon.apk {
		width: 24px;
		height: 24px;
	}

	.store-copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		line-height: 1.15;
		text-align: left;
	}

	.store-copy small {
		font-size: 11px;
		font-weight: 500;
		color: rgba(255, 255, 255, 0.82);
	}

	.store-copy strong {
		font-size: 17px;
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.trust-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 10px 14px;
		max-width: 560px;
		margin-top: 6px;
	}

	.stars {
		display: inline-flex;
		gap: 2px;
		color: #f5b301;
	}

	.trust-text {
		margin: 0;
		font-size: 14px;
		color: var(--ink-muted);
		line-height: 1.5;
	}

	@media (max-width: 480px) {
		.store-badge {
			width: 100%;
			justify-content: center;
		}

		.trust-row {
			flex-direction: column;
			text-align: center;
		}
	}
</style>
