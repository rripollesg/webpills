---
import type { UI } from '../i18n';
import { screenshotFiles } from '../i18n/types';

interface Props {
	t: UI;
}

const { t } = Astro.props;
---

<section id="experiencia" class="showcases">
	<div class="container diary reveal">
		<div class="diary-grid">
			<div class="mock-card">
				<p class="mock-label">{t.showcases.diary.mock.zonesLabel}</p>
				<span class="zone-tag">{t.showcases.diary.mock.zone}</span>

				<div class="alert-box">
					<p class="alert-title">{t.showcases.diary.mock.alertTitle}</p>
					<p class="alert-body">{t.showcases.diary.mock.alertBody}</p>
				</div>

				<div class="cie-box">
					<p class="cie-title">{t.showcases.diary.mock.cieTitle}</p>
					<div class="cie-tags">
						<span>CIE-10 N94.4</span>
						<span>CIE-10 N94.6</span>
					</div>
					<p class="cie-desc">{t.showcases.diary.mock.cieDesc}</p>
				</div>

				<div class="eva-box">
					<span>{t.showcases.diary.mock.evaLabel}</span>
					<strong>7</strong>
				</div>

				<img
					class="mock-shot"
					src={screenshotFiles.dolor}
					alt={t.showcases.diary.title}
					loading="lazy"
				/>
			</div>

			<div class="copy">
				<span class="eyebrow">{t.showcases.diary.eyebrow}</span>
				<h2>{t.showcases.diary.title}</h2>
				<p>{t.showcases.diary.description}</p>
				<ul>
					{
						t.showcases.diary.bullets.map((item) => (
							<li>
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
									<path
										d="M5 12.5 9.5 17 19 7"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
									/>
								</svg>
								{item}
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>

	<div class="container cycle reveal">
		<div class="cycle-grid">
			<div class="copy">
				<span class="eyebrow">{t.showcases.cycle.eyebrow}</span>
				<h2>{t.showcases.cycle.title}</h2>
				<p>{t.showcases.cycle.description}</p>
				<ul>
					{
						t.showcases.cycle.bullets.map((item) => (
							<li>
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
									<path
										d="M5 12.5 9.5 17 19 7"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
									/>
								</svg>
								{item}
							</li>
						))
					}
				</ul>
			</div>

			<div class="phone-frame cycle-frame">
				<img
					src={screenshotFiles.ciclo}
					alt={t.showcases.cycle.title}
					loading="lazy"
					width="320"
					height="640"
				/>
			</div>
		</div>
	</div>
</section>

<style>
	.showcases {
		padding: 72px 0 0;
	}

	.diary-grid,
	.cycle-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 48px;
		align-items: center;
	}

	.cycle {
		margin-top: 80px;
		padding-bottom: 72px;
	}

	.copy h2 {
		font-size: clamp(26px, 3vw, 36px);
		margin: 16px 0 14px;
	}

	.copy > p {
		color: var(--ink-muted);
		font-size: 17px;
		line-height: 1.6;
	}

	.copy ul {
		list-style: none;
		margin: 24px 0 0;
		padding: 0;
		display: grid;
		gap: 12px;
	}

	.copy li {
		display: flex;
		align-items: flex-start;
		gap: 10px;
		font-size: 14.5px;
		color: var(--ink);
	}

	.copy li svg {
		flex-shrink: 0;
		margin-top: 2px;
		color: var(--mint);
	}

	.mock-card {
		position: relative;
		border-radius: var(--radius-lg);
		border: 1px solid var(--border);
		background: var(--bg-elevated);
		padding: 24px;
		box-shadow: var(--shadow);
		overflow: hidden;
	}

	.mock-label {
		font-size: 13px;
		font-weight: 700;
		color: var(--ink-muted);
		margin-bottom: 8px;
	}

	.zone-tag {
		display: inline-flex;
		align-items: center;
		padding: 6px 12px;
		border-radius: var(--radius-pill);
		background: var(--bg-soft);
		font-size: 12px;
		font-weight: 700;
		color: var(--ink);
	}

	.alert-box {
		margin-top: 16px;
		padding: 14px;
		border-radius: var(--radius-md);
		background: rgba(255, 120, 100, 0.12);
		border: 1px solid rgba(255, 120, 100, 0.2);
	}

	.alert-title {
		font-size: 14px;
		font-weight: 700;
		color: #ffb4a8;
	}

	.alert-body {
		margin-top: 6px;
		font-size: 12px;
		color: var(--ink-muted);
		line-height: 1.5;
	}

	.cie-box {
		margin-top: 14px;
		padding: 14px;
		border-radius: var(--radius-md);
		border: 1px solid var(--border);
	}

	.cie-title {
		font-size: 14px;
		font-weight: 700;
	}

	.cie-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 8px;
	}

	.cie-tags span {
		padding: 4px 10px;
		border-radius: var(--radius-pill);
		background: var(--bg-soft);
		font-size: 11px;
		font-weight: 600;
		color: var(--ink-muted);
	}

	.cie-desc {
		margin-top: 8px;
		font-size: 12px;
		color: var(--ink-muted);
		line-height: 1.5;
	}

	.eva-box {
		margin-top: 14px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 14px 16px;
		border-radius: var(--radius-md);
		background: var(--mint-dim);
		border: 1px solid var(--border-strong);
	}

	.eva-box span {
		font-size: 14px;
		font-weight: 700;
		color: var(--mint);
	}

	.eva-box strong {
		width: 36px;
		height: 36px;
		border-radius: 50%;
		display: grid;
		place-items: center;
		background: var(--mint);
		color: #042029;
		font-size: 14px;
	}

	.mock-shot {
		position: absolute;
		right: -20px;
		bottom: -40px;
		width: 42%;
		border-radius: 20px;
		border: 3px solid rgba(255, 255, 255, 0.08);
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
		opacity: 0.95;
	}

	.phone-frame {
		max-width: 320px;
		margin: 0 auto;
		border-radius: 32px;
		padding: 10px;
		background: linear-gradient(160deg, #1a3340, #0a1921);
		border: 2px solid rgba(125, 255, 240, 0.15);
		box-shadow: var(--shadow);
		overflow: hidden;
	}

	.phone-frame img {
		width: 100%;
		height: auto;
		display: block;
		border-radius: 24px;
	}

	.cycle-frame {
		justify-self: center;
	}

	@media (max-width: 900px) {
		.diary-grid,
		.cycle-grid {
			grid-template-columns: 1fr;
		}

		.diary-grid .mock-card {
			order: 2;
		}

		.diary-grid .copy {
			order: 1;
		}

		.mock-shot {
			width: 38%;
			bottom: -20px;
		}
	}
</style>
