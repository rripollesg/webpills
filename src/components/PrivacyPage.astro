---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { type Lang, useTranslations, usePrivacy, localePath } from '../i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const p = usePrivacy(lang);
const home = localePath(lang);
---

<Layout title={p.metaTitle} description={p.metaDescription} lang={lang} path="privacy">
	<Header lang={lang} t={t} path="privacy" sectionBase={home} />
	<main class="privacy-page">
		<article class="container doc">
			<a class="back" href={home}>{p.backHome}</a>
			<header class="doc-head">
				<h1>{p.title}</h1>
				<p class="updated">{p.updated}</p>
				<p class="intro">{p.intro}</p>
			</header>

			{
				p.sections.map((section, index) => (
					<section id={section.id} class="doc-section">
						<h2>{section.title}</h2>
						{section.body.map((paragraph) => (
							<p>{paragraph}</p>
						))}
						{index === 1 && (
							<div class="table-wrap">
								<p class="table-caption">{p.tableCaption}</p>
								<table>
									<thead>
										<tr>
											{p.tableHeaders.map((h) => (
												<th scope="col">{h}</th>
											))}
										</tr>
									</thead>
									<tbody>
										{p.tableRows.map((row) => (
											<tr>
												{row.map((cell) => (
													<td>{cell}</td>
												))}
											</tr>
										))}
									</tbody>
								</table>
							</div>
						)}
					</section>
				))
			}
		</article>
	</main>
	<Footer lang={lang} t={t} path="privacy" sectionBase={home} />
</Layout>

<style>
	.privacy-page {
		padding: 140px 0 80px;
		background:
			radial-gradient(700px 360px at 80% 0%, rgba(125, 255, 240, 0.06), transparent),
			var(--bg);
		min-height: 70vh;
	}

	.doc {
		max-width: 760px;
	}

	.back {
		display: inline-flex;
		margin-bottom: 28px;
		font-size: 14px;
		font-weight: 650;
		color: var(--mint);
	}

	.doc-head {
		margin-bottom: 40px;
		padding-bottom: 28px;
		border-bottom: 1px solid var(--border);
	}

	h1 {
		font-size: clamp(32px, 4vw, 44px);
		margin-bottom: 12px;
	}

	.updated {
		font-size: 13px;
		color: var(--ink-faint);
		margin-bottom: 16px;
	}

	.intro {
		color: var(--ink-muted);
		font-size: 17px;
		line-height: 1.6;
	}

	.doc-section {
		margin-bottom: 36px;
	}

	.doc-section h2 {
		font-size: 22px;
		margin-bottom: 14px;
		color: var(--mint-soft);
	}

	.doc-section p {
		color: var(--ink-muted);
		font-size: 15.5px;
		line-height: 1.65;
		margin-bottom: 12px;
	}

	.table-wrap {
		margin-top: 20px;
		overflow-x: auto;
		border-radius: 16px;
		border: 1px solid var(--border);
		background: rgba(15, 36, 48, 0.65);
	}

	.table-caption {
		padding: 14px 16px 0;
		font-size: 13px;
		font-weight: 650;
		color: var(--mint);
		margin: 0 !important;
	}

	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 13.5px;
	}

	th,
	td {
		text-align: left;
		padding: 12px 16px;
		border-top: 1px solid var(--border);
		vertical-align: top;
		color: var(--ink-muted);
	}

	th {
		color: var(--ink);
		font-weight: 700;
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	@media (max-width: 640px) {
		th:nth-child(3),
		td:nth-child(3) {
			display: none;
		}
	}
</style>
