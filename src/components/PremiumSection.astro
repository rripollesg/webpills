---
import type { UI } from '../i18n';

interface Props {
	t: UI;
}

const { t } = Astro.props;
const plans = [
	{ ...t.premium.free, highlighted: false },
	{ ...t.premium.paid, highlighted: true },
];
---

<section id="premium" class="premium light-section">
	<div class="container">
		<div class="section-head reveal">
			<span class="eyebrow light">{t.premium.eyebrow}</span>
			<h2>{t.premium.title}</h2>
			<p>{t.premium.description}</p>
		</div>

		<div class="plans">
			{
				plans.map((plan) => (
					<article class:list={['plan', 'reveal', { highlighted: plan.highlighted }]}>
						{plan.highlighted && <span class="badge">{t.premium.recommended}</span>}
						<h3>{plan.name}</h3>
						<div class="price">
							<strong>{plan.price}</strong>
							<span>{plan.period}</span>
						</div>
						<ul>
							{plan.features.map((feature) => (
								<li>
									<span aria-hidden="true">✓</span>
									{feature}
								</li>
							))}
						</ul>
						<a href="#descargar" class:list={['btn', plan.highlighted ? 'btn-primary' : 'btn-ghost']}>
							{plan.cta}
						</a>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.light-section {
		background: var(--light);
		color: var(--light-ink);
	}

	.light-section h2,
	.light-section h3 {
		color: var(--light-ink);
	}

	.eyebrow.light {
		background: rgba(26, 168, 155, 0.1);
		border-color: rgba(26, 168, 155, 0.25);
		color: #0f766e;
	}

	.section-head p {
		color: #5b6f78;
	}

	.plans {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 20px;
		max-width: 820px;
		margin: 0 auto;
	}

	.plan {
		position: relative;
		background: #fff;
		border: 1.5px solid rgba(26, 46, 56, 0.1);
		border-radius: 24px;
		padding: 32px 28px;
		display: flex;
		flex-direction: column;
	}

	.plan.highlighted {
		border-color: #0f766e;
		box-shadow: 0 20px 48px rgba(15, 80, 70, 0.12);
	}

	.badge {
		position: absolute;
		top: -12px;
		left: 24px;
		background: #0f766e;
		color: #fff;
		font-size: 12px;
		font-weight: 700;
		padding: 6px 12px;
		border-radius: var(--radius-pill);
	}

	.price {
		display: flex;
		align-items: baseline;
		gap: 8px;
		margin: 12px 0 22px;
	}

	.price strong {
		font-size: 32px;
		letter-spacing: -0.03em;
	}

	.price span {
		font-size: 13px;
		color: #6b8089;
	}

	ul {
		list-style: none;
		padding: 0;
		margin: 0 0 28px;
		display: grid;
		gap: 12px;
		flex: 1;
	}

	li {
		display: flex;
		gap: 10px;
		font-size: 14.5px;
		color: #334850;
	}

	li span {
		color: #0f766e;
		font-weight: 700;
	}

	.btn-ghost {
		background: transparent;
		border: 1.5px solid rgba(26, 46, 56, 0.14);
		color: var(--light-ink);
	}

	.btn-ghost:hover {
		border-color: #0f766e;
		color: #0f766e;
	}

	.plan .btn {
		width: 100%;
	}

	@media (max-width: 720px) {
		.plans {
			grid-template-columns: 1fr;
		}
	}
</style>
