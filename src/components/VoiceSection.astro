---
import type { UI } from '../i18n';

interface Props {
	t: UI;
}

const { t } = Astro.props;
---

<section id="voz" class="voice">
	<div class="container">
		<div class="section-head reveal">
			<span class="eyebrow voice-eyebrow">{t.voice.eyebrow}</span>
			<h2>{t.voice.title}</h2>
			<p>{t.voice.description}</p>
		</div>

		<div class="cards">
			{
				t.voice.items.map((item) => (
					<article class="card reveal">
						<span class="mic-icon" aria-hidden="true">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none">
								<rect x="9.2" y="3.5" width="5.6" height="10" rx="2.8" stroke="currentColor" stroke-width="1.8" />
								<path
									d="M6.5 11.5a5.5 5.5 0 0 0 11 0M12 17v3.5M9.5 20.5h5"
									stroke="currentColor"
									stroke-width="1.8"
									stroke-linecap="round"
								/>
							</svg>
						</span>
						<h3>{item.label}</h3>
						<p>{item.phrase}</p>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.voice {
		padding: 72px 0;
		background:
			radial-gradient(600px 300px at 50% 0%, rgba(125, 255, 240, 0.1), transparent),
			linear-gradient(180deg, #0d2834, #0a1921);
		border-block: 1px solid var(--border);
	}

	.voice-eyebrow {
		background: rgba(255, 255, 255, 0.08);
		border-color: rgba(255, 255, 255, 0.15);
	}

	.voice h2,
	.voice h3 {
		color: #fff;
	}

	.voice .section-head p {
		color: rgba(232, 241, 244, 0.75);
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
		max-width: 900px;
		margin: 0 auto;
	}

	.card {
		text-align: center;
		padding: 28px 20px;
		border-radius: var(--radius-md);
		border: 1px solid rgba(255, 255, 255, 0.12);
		background: rgba(255, 255, 255, 0.04);
		backdrop-filter: blur(8px);
	}

	.mic-icon {
		display: inline-grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 14px;
		background: rgba(125, 255, 240, 0.12);
		color: var(--mint);
		margin-bottom: 14px;
	}

	.card h3 {
		font-size: 15px;
		margin-bottom: 8px;
	}

	.card p {
		font-size: 14px;
		color: rgba(232, 241, 244, 0.65);
		line-height: 1.5;
		font-style: italic;
	}

	@media (max-width: 720px) {
		.cards {
			grid-template-columns: 1fr;
		}
	}
</style>
