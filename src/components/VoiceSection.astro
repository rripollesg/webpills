---
import type { UI } from '../i18n';

interface Props {
	t: UI;
}

const { t } = Astro.props;
const assistants = t.voice.assistants;
---

<section id="voz" class="voice">
	<div class="container">
		<div class="section-head reveal">
			<span class="eyebrow voice-eyebrow">{t.voice.eyebrow}</span>
			<h2>{t.voice.title}</h2>
			<p>{t.voice.description}</p>
			<p class="hint">{t.voice.hint}</p>
		</div>

		<div class="tabs reveal">
			<div class="tab-nav">
				{
					assistants.map((assistant, index) => (
						<div class="tab-nav-item">
							<input
								type="radio"
								name="voice-assistant"
								id={`voice-tab-${assistant.id}`}
								class="tab-input"
								checked={index === 0}
							/>
							<label for={`voice-tab-${assistant.id}`} class="tab-label">
								{assistant.name}
							</label>
						</div>
					))
				}
			</div>

			<div class="tab-panels">
				{
					assistants.map((assistant) => (
						<article class="tab-panel" data-assistant={assistant.id}>
							<p class="platform">{assistant.platform}</p>

							<ol class="steps">
								{assistant.steps.map((step) => <li>{step}</li>)}
							</ol>

							<ul class="phrases">
								{assistant.phrases.map((phrase) => <li>{phrase}</li>)}
							</ul>

							{assistant.limitNote && <p class="limit-note">{assistant.limitNote}</p>}
						</article>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	.voice {
		padding: 72px 0;
		background:
			radial-gradient(600px 300px at 50% 0%, rgba(125, 255, 240, 0.1), transparent),
			linear-gradient(180deg, #0d2834, #0a1921);
		border-block: 1px solid var(--border);
	}

	.voice-eyebrow {
		background: rgba(255, 255, 255, 0.08);
		border-color: rgba(255, 255, 255, 0.15);
	}

	.voice h2 {
		color: #fff;
	}

	.voice .section-head p {
		color: rgba(232, 241, 244, 0.75);
	}

	.hint {
		margin-top: 12px;
		font-size: 14px;
		color: rgba(232, 241, 244, 0.55) !important;
	}

	.tabs {
		max-width: 720px;
		margin: 36px auto 0;
		border-radius: var(--radius-md);
		border: 1px solid rgba(255, 255, 255, 0.12);
		background: rgba(255, 255, 255, 0.03);
		overflow: hidden;
	}

	.tab-nav {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		background: rgba(0, 0, 0, 0.15);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	.tab-nav-item {
		position: relative;
	}

	.tab-input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.tab-label {
		display: block;
		padding: 14px 12px;
		text-align: center;
		font-size: 14px;
		font-weight: 700;
		color: rgba(232, 241, 244, 0.65);
		cursor: pointer;
		transition: color 0.2s, background 0.2s;
	}

	.tab-label:hover {
		color: #fff;
	}

	.tab-input:checked + .tab-label {
		color: var(--mint);
		background: rgba(125, 255, 240, 0.08);
		box-shadow: inset 0 -2px 0 var(--mint);
	}

	.tab-panel {
		display: none;
		padding: 24px;
	}

	.tabs:has(#voice-tab-siri:checked) [data-assistant='siri'],
	.tabs:has(#voice-tab-google:checked) [data-assistant='google'],
	.tabs:has(#voice-tab-alexa:checked) [data-assistant='alexa'] {
		display: block;
	}

	.platform {
		margin: 0 0 16px;
		font-size: 13px;
		color: rgba(232, 241, 244, 0.55);
	}

	.steps {
		margin: 0 0 18px;
		padding-left: 20px;
		color: rgba(232, 241, 244, 0.82);
		font-size: 14px;
		line-height: 1.5;
	}

	.steps li + li {
		margin-top: 6px;
	}

	.phrases {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 8px;
	}

	.phrases li {
		padding: 12px 14px;
		border-radius: var(--radius-sm);
		background: rgba(0, 0, 0, 0.18);
		border: 1px solid rgba(255, 255, 255, 0.08);
		color: rgba(232, 241, 244, 0.88);
		font-size: 14px;
		font-style: italic;
		line-height: 1.4;
	}

	.limit-note {
		margin: 16px 0 0;
		padding: 12px 14px;
		border-radius: var(--radius-sm);
		background: rgba(212, 83, 74, 0.1);
		border: 1px solid rgba(212, 83, 74, 0.22);
		color: rgba(255, 220, 216, 0.9);
		font-size: 13px;
		line-height: 1.45;
	}

	@media (max-width: 560px) {
		.tab-label {
			padding: 12px 8px;
			font-size: 13px;
		}
	}
</style>
