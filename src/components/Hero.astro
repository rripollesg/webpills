---
import type { UI } from '../i18n';
import { screenshotFiles } from '../i18n/types';

interface Props {
	t: UI;
}

const { t } = Astro.props;

const heroPhones = [
	{ src: screenshotFiles.historial, alt: t.screenshots.gallery[0]?.title ?? 'Pills' },
	{ src: screenshotFiles.constantes, alt: t.screenshots.gallery[5]?.title ?? 'Pills' },
	{ src: screenshotFiles.ciclo, alt: t.screenshots.gallery[6]?.title ?? 'Pills' },
];
---

<section id="top" class="hero">
	<div class="container hero-grid">
		<div class="hero-copy">
			<div class="badge">
				<span class="dot" aria-hidden="true"></span>
				{t.hero.badge}
			</div>

			<h1>
				{t.hero.titleBefore}
				<span>{t.hero.titleAccent}</span>
			</h1>

			<p class="lead">{t.hero.description}</p>

			<div class="actions">
				<a href="#funciones" class="btn btn-hero-secondary">
					{t.hero.ctaSecondary}
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path
							d="M5 12h14M13 6l6 6-6 6"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
				</a>
			</div>
		</div>

		<div class="phones" aria-hidden="true">
			{
				heroPhones.map((phone, i) => (
					<div class={`phone phone-${i + 1}`}>
						<div class="phone-frame">
							<img
								src={phone.src}
								alt={phone.alt}
								loading="eager"
								decoding="async"
								fetchpriority={i === 1 ? 'high' : 'auto'}
								width="360"
								height="800"
							/>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		padding: 148px 0 80px;
		overflow: hidden;
	}

	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 0;
		background-image:
			linear-gradient(rgba(125, 255, 240, 0.07) 1px, transparent 1px),
			linear-gradient(90deg, rgba(125, 255, 240, 0.07) 1px, transparent 1px);
		background-size: 40px 40px;
		mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.65), transparent 88%);
	}

	.hero::after {
		content: '';
		position: absolute;
		right: -4%;
		top: 10%;
		width: min(580px, 58vw);
		height: min(580px, 58vw);
		border-radius: 50%;
		background: radial-gradient(circle, rgba(125, 255, 240, 0.18) 0%, transparent 65%);
		pointer-events: none;
		z-index: 0;
	}

	.hero-grid {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 40px;
		align-items: center;
	}

	.hero-copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 22px;
		max-width: 560px;
		position: relative;
		z-index: 2;
	}

	.badge {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 8px 16px;
		border-radius: var(--radius-pill);
		background: rgba(15, 36, 48, 0.95);
		border: 1px solid rgba(125, 255, 240, 0.35);
		color: #e2edf2;
		font-size: 12px;
		font-weight: 650;
		letter-spacing: 0.08em;
	}

	.dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--mint);
		box-shadow: 0 0 0 4px rgba(125, 255, 240, 0.28);
	}

	.hero h1 {
		font-size: clamp(34px, 5vw, 56px);
		font-weight: 800;
		text-wrap: balance;
		color: #ffffff;
		text-rendering: optimizeLegibility;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	.hero h1 span {
		color: var(--mint);
		display: block;
	}

	.lead {
		font-size: clamp(16px, 2vw, 18px);
		color: #d4e0e6;
		line-height: 1.65;
		max-width: 52ch;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 4px;
	}

	.btn-hero-secondary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		padding: 14px 26px;
		border-radius: var(--radius-pill);
		font-weight: 700;
		font-size: 15px;
		background: #ffffff;
		color: #07141c;
		border: 2px solid #ffffff;
		box-shadow:
			0 4px 0 rgba(255, 255, 255, 0.15),
			0 16px 40px rgba(0, 0, 0, 0.35);
		transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
	}

	.btn-hero-secondary:hover {
		transform: translateY(-2px);
		background: var(--mint-soft);
		border-color: var(--mint-soft);
		color: #042029;
		box-shadow:
			0 4px 0 rgba(125, 255, 240, 0.2),
			0 20px 44px rgba(125, 255, 240, 0.32);
	}

	.phones {
		position: relative;
		height: 520px;
		min-width: 0;
		z-index: 2;
		filter: drop-shadow(0 24px 48px rgba(0, 0, 0, 0.45));
	}

	.phone {
		position: absolute;
		width: 218px;
		transition: transform 0.3s ease;
		backface-visibility: hidden;
		-webkit-backface-visibility: hidden;
	}

	.phone-frame {
		border-radius: 32px;
		padding: 8px;
		background: linear-gradient(165deg, #2a4a5a 0%, #122a36 45%, #0a1921 100%);
		border: 2px solid rgba(125, 255, 240, 0.45);
		box-shadow:
			0 0 0 1px rgba(255, 255, 255, 0.08),
			0 22px 44px rgba(0, 0, 0, 0.42),
			inset 0 1px 0 rgba(255, 255, 255, 0.12);
		overflow: hidden;
		transform: translateZ(0);
	}

	.phone-frame img {
		width: 100%;
		height: auto;
		border-radius: 24px;
		display: block;
		background: #fff;
	}

	.phone-1 {
		left: 0;
		top: 40px;
		z-index: 1;
		transform: rotate(-6deg) translateZ(0);
	}

	.phone-2 {
		left: 50%;
		top: 0;
		transform: translateX(-50%) translateZ(0);
		z-index: 3;
		width: 238px;
	}

	.phone-3 {
		right: 0;
		top: 50px;
		z-index: 2;
		transform: rotate(6deg) translateZ(0);
	}

	.phones:hover .phone-1 {
		transform: rotate(-7deg) translateY(-6px) translateZ(0);
	}

	.phones:hover .phone-2 {
		transform: translateX(-50%) translateY(-8px) translateZ(0);
	}

	.phones:hover .phone-3 {
		transform: rotate(7deg) translateY(-6px) translateZ(0);
	}

	@media (max-width: 960px) {
		.hero-grid {
			grid-template-columns: 1fr;
			text-align: center;
		}

		.hero-copy {
			align-items: center;
			max-width: 100%;
		}

		.actions {
			justify-content: center;
		}

		.phones {
			height: 380px;
			max-width: 420px;
			margin: 0 auto;
		}

		.phone {
			width: 160px;
		}

		.phone-2 {
			width: 180px;
		}
	}

	@media (max-width: 640px) {
		.hero {
			padding-top: 130px;
		}

		.actions {
			width: 100%;
		}

		.actions .btn {
			width: 100%;
		}

		.phones {
			height: 320px;
		}

		.phone {
			width: 130px;
		}

		.phone-2 {
			width: 150px;
		}
	}
</style>
