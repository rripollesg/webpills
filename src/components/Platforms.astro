---
import type { UI } from '../i18n';

interface Props {
	t: UI;
}

const { t } = Astro.props;

const icons: Record<string, string> = {
	phone:
		'<rect x="7" y="3" width="10" height="18" rx="2.2"/><path d="M10 6h4"/>',
	tv: '<rect x="3.5" y="5.5" width="17" height="11.5" rx="2"/><path d="M9 20h6M12 17v3"/>',
};
---

<section id="plataformas" class="platforms light-section">
	<div class="container">
		<div class="section-head reveal">
			<span class="eyebrow light">{t.platforms.eyebrow}</span>
			<h2>{t.platforms.title}</h2>
			<p>{t.platforms.description}</p>
		</div>

		<div class="grid">
			{
				t.platforms.items.map((item) => (
					<article class="card reveal">
						<span class="icon" aria-hidden="true">
							<svg
								width="26"
								height="26"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.8"
								stroke-linecap="round"
								stroke-linejoin="round"
								set:html={icons[item.icon]}
							/>
						</span>
						<h3>{item.title}</h3>
						<p>{item.description}</p>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.light-section {
		background: var(--light);
		color: var(--light-ink);
		padding: 72px 0;
	}

	.light-section h2,
	.light-section h3 {
		color: var(--light-ink);
	}

	.eyebrow.light {
		background: rgba(26, 168, 155, 0.1);
		border-color: rgba(26, 168, 155, 0.25);
		color: #0f766e;
	}

	.section-head p {
		color: #5b6f78;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 18px;
		max-width: 720px;
		margin: 0 auto;
	}

	.card {
		text-align: center;
		background: #fff;
		border: 1px solid rgba(26, 46, 56, 0.08);
		border-radius: var(--radius-lg);
		padding: 36px 24px;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.card:hover {
		transform: translateY(-4px);
		box-shadow: 0 18px 40px rgba(15, 40, 50, 0.08);
	}

	.icon {
		display: inline-grid;
		place-items: center;
		width: 56px;
		height: 56px;
		border-radius: 18px;
		background: rgba(139, 92, 246, 0.12);
		color: #7c3aed;
		margin-bottom: 18px;
	}

	.card h3 {
		font-size: 18px;
		margin-bottom: 8px;
	}

	.card p {
		font-size: 14.5px;
		color: #5b6f78;
		line-height: 1.55;
	}

	@media (max-width: 760px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
